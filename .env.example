NODE_ENV=development
PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/license_verification
API_KEY=replace-with-your-existing-api-key
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
TRUST_PROXY=false
ALLOW_MISSING_DOMAIN=true

# Isolated staff/customer authentication. Generate independent random secrets.
# JWT_SECRET: >=32 random bytes; AUTH_2FA_ENCRYPTION_KEY: 32 bytes encoded as 64 hex characters.
JWT_SECRET=replace-with-a-cryptographically-random-secret-at-least-32-bytes
AUTH_2FA_ENCRYPTION_KEY=replace-with-64-random-hex-characters
FRONTEND_URL=http://localhost:5173
# Additional exact trusted origins, comma separated; no wildcard.
AUTH_CORS_ORIGINS=http://localhost:3000
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-smtp-user
SMTP_PASS=replace-with-smtp-password
SMTP_FROM=no-reply@example.com
# Frontend optional: VITE_AUTH_API_BASE_URL=/api (same-site deployment required)
